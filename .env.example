GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=10

# local: sqlite / Cloud Run: firestore
STORAGE_BACKEND=sqlite
AUTH_REQUIRED=false
PROTOTYPE_USER_ID=prototype
APP_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=change_this_to_a_long_random_string

# Production with LINE Login + Firestore
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_REQUEST_EMAIL=false
GOOGLE_APPLICATION_CREDENTIALS_JSON=paste_google_service_account_json_in_render_only
